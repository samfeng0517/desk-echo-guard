import { ComboBox, Switch } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Tips } from "../tips.slint";
import { Tip, Card, SettingsCard, RadioOption, LinkText, FluentIcon, Caption, InfoBar } from "../controls.slint";
import { AppState, Cfg, Links } from "../state.slint";
import { Page, Section } from "page.slint";

export global SiriText {
    out property <[string]> profiles: ["標準（推薦）", "輕微", "較淺", "加強"];
    out property <[string]> profile-desc: [
        "削掉 Siri 最在意的整段高音（2.8–6.5 kHz），這段擋得最徹底；但子音也在這段，對方說話會比較不清楚。聽不清楚時改用「輕微」。",
        "仿照 Apple 發表會，只削幾個很窄的頻段。幾乎聽不出來，說話最清楚，但擋得比較少。",
        "範圍和「標準」一樣，削得比較淺。子音一樣會比較不清楚。",
        "再多削一段中音，最有效，但對方聲音明顯變悶。建議搭配「只在「s」音時處理」。",
    ];
}

export component SiriPage inherits Page {
    title: "Hey Siri 防誤觸";

    // ---- what this is
    Card {
        pad: 20px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: start;
                FluentIcon {
                    width: 28px;
                    height: 28px;
                    source: Icons.voice;
                    tint: Theme.accent;
                }
            }
            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    text: "家裡有 HomePod / iPhone 嗎？";
                    font-size: Theme.body-large;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: "通話對方說「Hey Siri」時，你的喇叭會把它播出來而叫醒 Siri。開啟後會在對方的聲音裡削掉 Siri 聽得到的頻段。";
                    font-size: Theme.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: "詳細說明與實測結果";
                        tip: Tips.siri-docs;
                        activated => {
                            AppState.open-url(Links.siri-docs);
                        }
                    }
                }
            }
        }
    }

    // requirements (VB-CABLE A+B, output device in the call app)
    for b in AppState.siri-bars: VerticalLayout {
        padding-top: 8px;
        InfoBar {
            severity: b.severity;
            title: b.title;
            message: b.message;
            action: b.action;
            action-tip: b.tip;
            action-clicked => {
                AppState.infobar-action(b.action-id);
            }
        }
    }

    Section {
        text: "設定";
    }
    SettingsCard {
        icon: Icons.shield;
        title: "啟用 Hey Siri 防誤觸";
        description: Cfg.siri-guard ? "通話軟體的喇叭要選「" + AppState.siri-speaker-name + "」" : "防止通話對方說的「Hey Siri」叫醒你的裝置";
        tip: Tips.siri-enable;
        Text {
            text: Cfg.siri-guard ? "開啟" : "關閉";
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
        Tip {
            tip: Tips.siri-enable;
            focused: sw.has-focus;
            sw := Switch {
                checked <=> Cfg.siri-guard;
                toggled => {
                    Cfg.changed();
                }
            }
        }
    }

    Card {
        Tip {
            tip: Tips.siri-mode;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    FluentIcon {
                        source: Icons.timer;
                        tint: Cfg.siri-guard ? Theme.text : Theme.text-disabled;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "模式";
                        font-size: Theme.body;
                        color: Cfg.siri-guard ? Theme.text : Theme.text-disabled;
                    }
                    Caption {
                        text: "什麼時候處理對方的聲音";
                        color: Cfg.siri-guard ? Theme.text-secondary : Theme.text-disabled;
                    }
                }
            }
        }
        VerticalLayout {
            padding-left: 36px;
            spacing: 4px;
            RadioOption {
                title: "一直處理（推薦）";
                description: "聲音稍微悶一點，不會增加延遲。";
                tip: Tips.mode-always;
                enabled: Cfg.siri-guard;
                selected: Cfg.siri-mode-index == 0;
                clicked => {
                    Cfg.siri-mode-index = 0;
                    Cfg.changed();
                }
            }
            RadioOption {
                title: "只在「s」音時處理";
                description: "延遲只多約 0.06 秒（聽不出來）；其他有 /s/ 音的字也會被短暫處理。";
                tip: Tips.mode-sibilant;
                enabled: Cfg.siri-guard;
                selected: Cfg.siri-mode-index == 1;
                clicked => {
                    Cfg.siri-mode-index = 1;
                    Cfg.changed();
                }
            }
        }
    }

    SettingsCard {
        icon: Icons.options;
        title: "強度";
        description: SiriText.profile-desc[Cfg.siri-profile-index];
        tip: Tips.siri-profile;
        enabled: Cfg.siri-guard;
        ComboBox {
            width: 200px;
            enabled: Cfg.siri-guard;
            model: SiriText.profiles;
            current-index <=> Cfg.siri-profile-index;
            selected => {
                Cfg.changed();
            }
        }
    }
}
