import { ComboBox, Slider, Switch } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Tips } from "../tips.slint";
import { Tip, Card, SettingsCard, RadioOption, LinkText, FluentIcon, Caption, InfoBar } from "../controls.slint";
import { AppState, Cfg, Links } from "../state.slint";
import { Page, Section } from "page.slint";

export global SiriText {
    out property <[string]> profiles: ["標準", "加強"];
    out property <[string]> profile-desc: [
        "削掉 1–6.5 kHz 的中高音，對方的聲音會變悶。模式是「只在「Hey Siri」時處理」時，從「Siri」的「s」音開始削。",
        "只影響「只在「Hey Siri」時處理」：對方一說「Hey」就先開始削，比較擋得住；但「嘿、黑」這類音也會讓聲音短暫變悶（每分鐘約 3 次）。「一直處理」時和標準一樣。",
    ];
}

export component SiriPage inherits Page {
    title: "Hey Siri 防誤觸";

    // ---- what this is
    Card {
        pad: 20px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: start;
                FluentIcon {
                    width: 28px;
                    height: 28px;
                    source: Icons.voice;
                    tint: Theme.accent;
                }
            }
            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    text: "家裡有 HomePod / iPhone 嗎？";
                    font-size: Theme.body-large;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: "通話對方說「Hey Siri」時，你的喇叭會把它播出來而叫醒 Siri。開啟後會在對方的聲音裡削掉 Siri 聽得到的頻段。";
                    font-size: Theme.body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: "詳細說明與實測結果";
                        tip: Tips.siri-docs;
                        activated => {
                            AppState.open-url(Links.siri-docs);
                        }
                    }
                }
            }
        }
    }

    // requirements (VB-CABLE A+B, output device in the call app)
    for b in AppState.siri-bars: VerticalLayout {
        padding-top: 8px;
        InfoBar {
            severity: b.severity;
            title: b.title;
            message: b.message;
            action: b.action;
            action-tip: b.tip;
            action-clicked => {
                AppState.infobar-action(b.action-id);
            }
        }
    }

    Section {
        text: "設定";
    }
    SettingsCard {
        icon: Icons.shield;
        title: "啟用 Hey Siri 防誤觸";
        description: Cfg.siri-guard ? "通話軟體的喇叭要選「" + AppState.siri-speaker-name + "」" : "防止通話對方說的「Hey Siri」叫醒你的裝置";
        tip: Tips.siri-enable;
        Text {
            text: Cfg.siri-guard ? "開啟" : "關閉";
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
        Tip {
            tip: Tips.siri-enable;
            focused: sw.has-focus;
            sw := Switch {
                checked <=> Cfg.siri-guard;
                toggled => {
                    Cfg.changed();
                }
            }
        }
    }

    Card {
        Tip {
            tip: Tips.siri-mode;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    FluentIcon {
                        source: Icons.timer;
                        tint: Cfg.siri-guard ? Theme.text : Theme.text-disabled;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "模式";
                        font-size: Theme.body;
                        color: Cfg.siri-guard ? Theme.text : Theme.text-disabled;
                    }
                    Caption {
                        text: "什麼時候處理對方的聲音";
                        color: Cfg.siri-guard ? Theme.text-secondary : Theme.text-disabled;
                    }
                }
            }
        }
        VerticalLayout {
            padding-left: 36px;
            spacing: 4px;
            RadioOption {
                title: "一直處理";
                description: "最保險，不會增加延遲；但對方的聲音會一直比較悶。";
                tip: Tips.mode-always;
                enabled: Cfg.siri-guard;
                selected: Cfg.siri-mode-index == 0;
                clicked => {
                    Cfg.siri-mode-index = 0;
                    Cfg.changed();
                }
            }
            RadioOption {
                title: "只在「Hey Siri」時處理";
                description: "聽到「Hey」接「s」音才處理，其他時候聲音不動；延遲只多約 0.06 秒。偶爾可能漏掉。";
                tip: Tips.mode-heysiri;
                enabled: Cfg.siri-guard;
                selected: Cfg.siri-mode-index == 1;
                clicked => {
                    Cfg.siri-mode-index = 1;
                    Cfg.changed();
                }
            }
        }
    }

    SettingsCard {
        icon: Icons.options;
        title: "強度";
        description: SiriText.profile-desc[Cfg.siri-profile-index];
        tip: Tips.siri-profile;
        enabled: Cfg.siri-guard;
        ComboBox {
            width: 200px;
            enabled: Cfg.siri-guard;
            model: SiriText.profiles;
            current-index <=> Cfg.siri-profile-index;
            selected => {
                Cfg.changed();
            }
        }
    }

    // ---- ducking (uses the same wiring: the call audio runs through us)
    Section {
        text: "對方說話時";
    }
    SettingsCard {
        icon: Icons.speaker-edit;
        title: "降低其他聲音的音量";
        description: "對方說話時，自動把影片、音樂、遊戲等其他程式調小聲，說完約 1 秒後恢復。需要上面的「啟用」打開。";
        tip: Tips.duck-others;
        enabled: Cfg.siri-guard;
        Tip {
            tip: Tips.duck-others;
            focused: duck-sw.has-focus;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: Cfg.duck-others ? "開啟" : "關閉";
                    font-size: Theme.body;
                    color: Cfg.siri-guard ? Theme.text : Theme.text-disabled;
                    vertical-alignment: center;
                }
                duck-sw := Switch {
                    enabled: Cfg.siri-guard;
                    checked <=> Cfg.duck-others;
                    toggled => {
                        Cfg.changed();
                    }
                }
            }
        }
    }
    SettingsCard {
        icon: Icons.options;
        title: "降低多少";
        description: "100% 是完全靜音，0% 是不降低。";
        tip: Tips.duck-percent;
        enabled: Cfg.siri-guard && Cfg.duck-others;
        Tip {
            tip: Tips.duck-percent;
            focused: duck.has-focus;
            HorizontalLayout {
                spacing: 12px;
                duck := Slider {
                    width: 180px;
                    enabled: Cfg.siri-guard && Cfg.duck-others;
                    minimum: 0;
                    maximum: 100;
                    step: 5;
                    value <=> Cfg.duck-percent;
                    changed(v) => {
                        Cfg.changed();
                    }
                }
                Text {
                    width: 52px;
                    text: round(Cfg.duck-percent) + "%";
                    font-size: Theme.body;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
