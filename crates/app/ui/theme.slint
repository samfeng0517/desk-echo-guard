// Windows 11 (Fluent) design tokens: colours, type ramp, spacing.
// Everything is on a 4 px grid.  Colours follow the system light / dark
// theme through Palette.color-scheme; the accent comes from Windows.

import { Palette } from "std-widgets.slint";

export enum Severity { info, success, warning, error }

export global Theme {
    // set from Rust when the Mica backdrop could be applied (Windows 11)
    in property <bool> mica: false;

    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // surfaces
    out property <brush> window-bg: mica ? transparent : (dark ? #202020 : #f3f3f3);
    out property <brush> card-bg: mica ? (dark ? #ffffff0d : #ffffffb3) : (dark ? #2b2b2b : #fbfbfb);
    out property <brush> card-bg-hover: dark ? #323232 : #f6f6f6;
    out property <brush> card-border: dark ? #1c1c1c : #e5e5e5;
    out property <brush> card-inner: dark ? #ffffff08 : #00000005;
    out property <brush> divider: dark ? #ffffff15 : #0000000f;
    out property <brush> nav-hover: dark ? #ffffff0f : #0000000a;
    out property <brush> nav-selected: dark ? #ffffff0f : #0000000a;
    out property <brush> scrim: dark ? #0000008c : #0000004d;
    out property <brush> flyout-bg: dark ? #2c2c2c : #f9f9f9;
    out property <brush> flyout-border: dark ? #ffffff1a : #0000001a;
    out property <brush> track: dark ? #ffffff24 : #00000017;

    // text
    out property <brush> text: dark ? #ffffff : #1a1a1a;
    out property <brush> text-secondary: dark ? #ffffffc8 : #5d5d5d;
    out property <brush> text-tertiary: dark ? #ffffff8b : #8a8a8a;
    out property <brush> text-disabled: dark ? #ffffff5d : #a0a0a0;
    out property <brush> accent: Palette.accent-background;
    out property <brush> accent-text: dark ? #99ebff : #003e92;
    out property <brush> on-accent: Palette.accent-foreground;

    // InfoBar backgrounds / icon colours (WinUI 3 values)
    out property <brush> info-bg: dark ? #2b2b2b : #f6f6f6;
    out property <brush> success-bg: dark ? #393d1b : #dff6dd;
    out property <brush> warning-bg: dark ? #433519 : #fff4ce;
    out property <brush> error-bg: dark ? #442726 : #fde7e9;
    out property <brush> info-icon: Palette.accent-background;
    out property <brush> success-icon: dark ? #6ccb5f : #0f7b0f;
    out property <brush> warning-icon: dark ? #fce100 : #9d5d00;
    out property <brush> error-icon: dark ? #ff99a4 : #c42b1c;

    // type ramp (Windows 11)
    out property <length> caption: 12px;
    out property <length> body: 14px;
    out property <length> body-large: 18px;
    out property <length> subtitle: 20px;
    out property <length> title: 28px;
    out property <length> display: 40px;

    // spacing / shape
    out property <length> radius: 8px;
    out property <length> radius-small: 4px;
    out property <length> page-padding: 36px;
    out property <length> card-gap: 4px;      // between cards of one group
    out property <length> section-gap: 28px;  // above a section header
    out property <length> card-padding: 16px;
    out property <length> content-max-width: 1000px;

    public pure function severity-bg(s: Severity) -> brush {
        if s == Severity.success { return success-bg; }
        if s == Severity.warning { return warning-bg; }
        if s == Severity.error { return error-bg; }
        return info-bg;
    }
    public pure function severity-icon-color(s: Severity) -> brush {
        if s == Severity.success { return success-icon; }
        if s == Severity.warning { return warning-icon; }
        if s == Severity.error { return error-icon; }
        return info-icon;
    }
}

// Fluent UI System Icons (MIT, see icons/LICENSE-fluentui-system-icons.txt)
export global Icons {
    out property <image> home: @image-url("icons/home.svg");
    out property <image> home-filled: @image-url("icons/home-filled.svg");
    out property <image> mic: @image-url("icons/mic.svg");
    out property <image> speaker: @image-url("icons/speaker.svg");
    out property <image> shield-check: @image-url("icons/shield-check.svg");
    out property <image> shield: @image-url("icons/shield.svg");
    out property <image> shield-off: @image-url("icons/shield-off.svg");
    out property <image> plug: @image-url("icons/plug.svg");
    out property <image> voice: @image-url("icons/voice.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> book: @image-url("icons/book.svg");
    out property <image> open: @image-url("icons/open.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> info-filled: @image-url("icons/info-filled.svg");
    out property <image> success-filled: @image-url("icons/success-filled.svg");
    out property <image> warning-filled: @image-url("icons/warning-filled.svg");
    out property <image> error-filled: @image-url("icons/error-filled.svg");
    out property <image> menu: @image-url("icons/menu.svg");
    out property <image> timer: @image-url("icons/timer.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> stop: @image-url("icons/stop.svg");
    out property <image> options: @image-url("icons/options.svg");
    out property <image> wrench: @image-url("icons/wrench.svg");
    out property <image> log: @image-url("icons/log.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> power: @image-url("icons/power.svg");
    out property <image> dismiss: @image-url("icons/dismiss.svg");
    out property <image> call: @image-url("icons/call.svg");
    out property <image> pulse: @image-url("icons/pulse.svg");
    out property <image> gauge: @image-url("icons/gauge.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> chevron-up: @image-url("icons/chevron-up.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> restore: @image-url("icons/restore.svg");
    out property <image> sync: @image-url("icons/sync.svg");
    out property <image> document: @image-url("icons/document.svg");
    out property <image> tag: @image-url("icons/tag.svg");
    out property <image> eye-off: @image-url("icons/eye-off.svg");
    out property <image> window: @image-url("icons/window.svg");
    out property <image> wave: @image-url("icons/wave.svg");
    out property <image> engine: @image-url("icons/engine.svg");
    out property <image> headphones: @image-url("icons/headphones.svg");
    out property <image> speaker-edit: @image-url("icons/speaker-edit.svg");
    out property <image> code: @image-url("icons/code.svg");
    out property <image> ruler: @image-url("icons/ruler.svg");
    out property <image> histogram: @image-url("icons/histogram.svg");
    out property <image> app-icon: @image-url("../../../assets/icon.png");

    public pure function severity(s: Severity) -> image {
        if s == Severity.success { return success-filled; }
        if s == Severity.warning { return warning-filled; }
        if s == Severity.error { return error-filled; }
        return info-filled;
    }
}
