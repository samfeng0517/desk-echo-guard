// Desk Echo Guard main window (Windows 11 / Fluent).  See ../UI.md.

import { CheckBox, Palette } from "std-widgets.slint";
import { Theme, Icons, Severity } from "theme.slint";
import { Tips } from "tips.slint";
import { Tip, NavItem, DialogFrame, Toast, ToolTipOverlay, TipState, Caption } from "controls.slint";
import { AppState, Cfg, Links, InfoBarData, DiagRow } from "state.slint";
import { HomePage } from "pages/home.slint";
import { DevicesPage } from "pages/devices.slint";
import { SiriPage } from "pages/siri.slint";
import { AdvancedPage } from "pages/advanced.slint";

export { AppState, Cfg, Links, InfoBarData, DiagRow, Theme, Severity, TipState, Tips }

export component AppWindow inherits Window {
    in property <string> font-family;

    title: "Desk Echo Guard";
    icon: Icons.app-icon;
    min-width: 760px;
    min-height: 560px;
    preferred-width: 900px;
    preferred-height: 640px;
    background: Theme.window-bg;
    default-font-family: root.font-family;
    default-font-size: Theme.body;

    // screenshots / tests: force the light or dark theme
    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    private property <bool> compact: AppState.nav-compact || root.width < 840px;
    private property <length> nav-width: root.compact ? 56px : 248px;

    HorizontalLayout {
        // ---------------------------------------------------- navigation
        nav := VerticalLayout {
            width: root.nav-width;
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;
            animate width { duration: 150ms; easing: ease-out; }

            // app header: menu button + icon + name
            HorizontalLayout {
                height: 40px;
                spacing: 4px;
                Tip {
                    tip: Tips.nav-toggle;
                    width: 48px;
                    clicked => {
                        AppState.nav-compact = !root.compact;
                    }
                    Rectangle {
                        border-radius: 4px;
                        background: parent.has-hover ? Theme.nav-hover : transparent;
                        Image {
                            width: 18px;
                            height: 18px;
                            source: Icons.menu;
                            colorize: Theme.text;
                        }
                    }
                }
                if !root.compact: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 20px;
                            height: 20px;
                            source: Icons.app-icon;
                        }
                    }
                    Text {
                        text: "Desk Echo Guard";
                        font-size: Theme.caption;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle {
                height: 8px;
            }
            NavItem {
                icon: AppState.page == 0 ? Icons.home-filled : Icons.home;
                text: "首頁";
                tip: Tips.nav-home;
                compact: root.compact;
                selected: AppState.page == 0;
                clicked => {
                    AppState.page = 0;
                    AppState.page-shown(0);
                }
            }
            NavItem {
                icon: Icons.mic;
                text: "裝置";
                tip: Tips.nav-devices;
                compact: root.compact;
                selected: AppState.page == 1;
                clicked => {
                    AppState.page = 1;
                    AppState.page-shown(1);
                }
            }
            NavItem {
                icon: Icons.voice;
                text: "Hey Siri 防誤觸";
                tip: Tips.nav-siri;
                compact: root.compact;
                selected: AppState.page == 2;
                clicked => {
                    AppState.page = 2;
                    AppState.page-shown(2);
                }
            }
            NavItem {
                icon: Icons.settings;
                text: "進階";
                tip: Tips.nav-advanced;
                compact: root.compact;
                selected: AppState.page == 3;
                clicked => {
                    AppState.page = 3;
                    AppState.page-shown(3);
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
            // running indicator above the docs link
            if !root.compact: HorizontalLayout {
                padding-left: 14px;
                padding-bottom: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: AppState.running ? Theme.success-icon : Theme.text-tertiary;
                    }
                }
                Caption {
                    text: AppState.running ? "回聲消除運作中" : "回聲消除已停止";
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            NavItem {
                icon: Icons.book;
                text: "說明文件";
                tip: Tips.nav-docs;
                compact: root.compact;
                external: true;
                clicked => {
                    AppState.open-url(Links.docs);
                }
            }
        }

        // ----------------------------------------------------- content
        Rectangle {
            horizontal-stretch: 1;
            if AppState.page == 0: HomePage { }
            if AppState.page == 1: DevicesPage { }
            if AppState.page == 2: SiriPage { }
            if AppState.page == 3: AdvancedPage { }
        }
    }

    // ------------------------------------------------------------ toast
    Toast {
        text: AppState.toast-text;
        shown: AppState.toast-shown;
        x: root.nav-width + (root.width - root.nav-width - self.width) / 2;
        y: root.height - self.height - 24px;
    }

    // ---------------------------------------------------------- dialogs
    if AppState.dialog == 1: DialogFrame {
        title: "整理 VB-Cable";
        primary-text: "開始整理";
        primary-enabled: AppState.dialog-rename || AppState.dialog-hide;
        primary => {
            AppState.dialog = 0;
            AppState.tidy-cable(AppState.dialog-rename, AppState.dialog-hide);
        }
        secondary => {
            AppState.dialog = 0;
        }

        Text {
            text: "VB-Cable 原本的名稱很容易搞混（「CABLE Input」其實是喇叭）。請勾選要做的事：";
            font-size: Theme.body;
            color: Theme.text;
            wrap: word-wrap;
        }
        Tip {
            tip: Tips.dialog-rename;
            VerticalLayout {
                spacing: 4px;
                CheckBox {
                    text: "改成好懂的名稱";
                    enabled: !AppState.cable-renamed;
                    checked <=> AppState.dialog-rename;
                }
                VerticalLayout {
                    padding-left: 28px;
                    spacing: 2px;
                    if AppState.cable-renamed: Caption {
                        text: "已經改過了。";
                    }
                    if !AppState.cable-renamed: Caption {
                        text: "通話軟體裡會看到這些新名稱：";
                    }
                    if !AppState.cable-renamed: for line in AppState.rename-lines: Caption {
                        text: "・" + line;
                    }
                }
            }
        }
        Tip {
            tip: Tips.dialog-hide;
            VerticalLayout {
                spacing: 4px;
                CheckBox {
                    text: "停用用不到的 VB-Cable 裝置";
                    enabled: AppState.unused-devices.length > 0;
                    checked <=> AppState.dialog-hide;
                }
                VerticalLayout {
                    padding-left: 28px;
                    spacing: 2px;
                    if AppState.unused-devices.length == 0: Caption {
                        text: "沒有用不到的裝置。";
                    }
                    if AppState.unused-devices.length > 0: Caption {
                        text: "Discord / LINE 的清單裡就不會再出現這些裝置（其他軟體例如 OBS 有用到的話請不要勾）：";
                    }
                    for name in AppState.unused-devices: Caption {
                        text: "・" + name;
                    }
                }
            }
        }
        Text {
            text: "按「開始整理」後，Windows 會跳出確認視窗，請按「是」。整理完請重新開啟 Discord / LINE，再選一次麥克風。之後可以在「裝置」頁還原。";
            font-size: Theme.body;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }

    if AppState.dialog == 2: DialogFrame {
        title: "還原 VB-Cable 原本的設定";
        primary-text: "還原";
        primary => {
            AppState.dialog = 0;
            AppState.restore-cable();
        }
        secondary => {
            AppState.dialog = 0;
        }
        Text {
            text: "會把 VB-Cable 的裝置名稱改回 VB-Audio 原本的名稱（例如「CABLE Output」），並重新啟用所有被停用的 VB-Cable 裝置。";
            font-size: Theme.body;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: "Windows 會跳出確認視窗，請按「是」。還原後請重新開啟 Discord / LINE，再選一次麥克風。";
            font-size: Theme.body;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }

    // --------------------------------------------- tooltip (topmost)
    ToolTipOverlay {
        width: root.width;
        height: root.height;
    }
}
