// Reusable Windows 11 style building blocks: tooltip, cards, InfoBar,
// meter, navigation item, radio option, dialog frame, toast.

import { Button, Palette } from "std-widgets.slint";
import { Theme, Icons, Severity } from "theme.slint";

// ------------------------------------------------------------------ text

export component Body inherits Text {
    font-size: Theme.body;
    color: Theme.text;
    wrap: word-wrap;
    vertical-alignment: center;
}

export component Caption inherits Text {
    font-size: Theme.caption;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

export component Strong inherits Text {
    font-size: Theme.body;
    font-weight: 600;
    color: Theme.text;
    vertical-alignment: center;
}

export component SectionHeader inherits Text {
    font-size: Theme.body;
    font-weight: 600;
    color: Theme.text;
    accessible-role: text;
}

export component FluentIcon inherits Image {
    in property <brush> tint: Theme.text;
    width: 20px;
    height: 20px;
    colorize: tint;
    image-fit: contain;
    accessible-role: none;
}

// ------------------------------------------------------------- tooltips
// One shared overlay (ToolTipOverlay, placed last in the window) shows the
// text of whichever Tip area is hovered or focused for 500 ms.

export global TipState {
    in-out property <string> text;
    in-out property <length> tx;     // target rect in window coordinates
    in-out property <length> ty;
    in-out property <length> tw;
    in-out property <length> th;
    in-out property <length> mx;     // pointer x when shown (wide targets)
    in-out property <bool> shown;
}

// Wrap any element in a Tip to give it a tooltip:  Tip { tip: Tips.x; Button {} }
// `focused` (optional) shows the tooltip on keyboard focus, too.
export component Tip inherits TouchArea {
    in property <string> tip;
    in property <bool> focused: false;
    private property <bool> focus-fresh: false;
    private property <bool> active: root.tip != "" && root.enabled && (root.has-hover || root.focus-fresh);

    changed focused => {
        root.focus-fresh = root.focused;
        if root.focused {
            focus-timer.running = true;
        }
    }
    changed active => {
        if root.active {
            delay.running = true;
        } else {
            delay.running = false;
            root.hide-tip();
        }
    }
    changed has-hover => {
        if !root.has-hover {
            root.focus-fresh = false;
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            delay.running = false;
            root.hide-tip();
        }
    }

    delay := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.show-tip();
        }
    }
    focus-timer := Timer {
        interval: 5s;
        running: false;
        triggered => {
            self.running = false;
            root.focus-fresh = false;
        }
    }

    function show-tip() {
        TipState.text = root.tip;
        TipState.tx = root.absolute-position.x;
        TipState.ty = root.absolute-position.y;
        TipState.tw = root.width;
        TipState.th = root.height;
        TipState.mx = root.has-hover ? root.absolute-position.x + root.mouse-x : root.absolute-position.x + root.width / 2;
        TipState.shown = true;
    }
    function hide-tip() {
        if TipState.shown && TipState.text == root.tip && TipState.tx == root.absolute-position.x && TipState.ty == root.absolute-position.y {
            TipState.shown = false;
        }
    }

    HorizontalLayout {
        @children
    }
}

export component ToolTipOverlay inherits Rectangle {
    private property <length> gap: 4px;
    private property <length> margin: 8px;
    private property <length> max-w: 320px;

    measure := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: TipState.text;
        font-size: 13px;
    }

    card := Rectangle {
        private property <length> below: TipState.ty + TipState.th + root.gap;
        private property <length> want-x: TipState.tw > self.width * 1.5 ? TipState.mx - 24px : TipState.tx + (TipState.tw - self.width) / 2;
        width: min(root.max-w, measure.preferred-width + 24px, root.width - 2 * root.margin);
        height: lay.preferred-height;
        x: max(root.margin, min(self.want-x, root.width - self.width - root.margin));
        y: self.below + self.height > root.height - root.margin ? max(root.margin, TipState.ty - self.height - root.gap) : self.below;
        opacity: TipState.shown ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 120ms; }
        background: Theme.flyout-bg;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.flyout-border;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000066 : #00000029;

        lay := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 9px;
            Text {
                text: TipState.text;
                font-size: 13px;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
    }
}

// ----------------------------------------------------------------- cards

// Windows 11 Settings card: icon, title, description, control on the right.
export component SettingsCard inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> tip;
    in property <bool> enabled: true;

    background: Theme.card-bg;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-border;
    accessible-role: groupbox;
    accessible-label: root.title;

    Tip {
        tip: root.tip;
        HorizontalLayout {
            padding-left: Theme.card-padding;
            padding-right: Theme.card-padding;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 16px;
            min-height: 68px;

            VerticalLayout {
                alignment: center;
                FluentIcon {
                    source: root.icon;
                    tint: root.enabled ? Theme.text : Theme.text-disabled;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                min-width: 120px;
                Text {
                    text: root.title;
                    font-size: Theme.body;
                    color: root.enabled ? Theme.text : Theme.text-disabled;
                    wrap: word-wrap;
                }
                if root.description != "": Caption {
                    text: root.description;
                    color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                HorizontalLayout {
                    spacing: 8px;
                    @children
                }
            }
        }
    }
}

// A plain card that holds arbitrary content (padding 16, radius 8).
export component Card inherits Rectangle {
    in property <length> pad: Theme.card-padding;
    background: Theme.card-bg;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: root.pad;
        spacing: 12px;
        @children
    }
}

// Row inside an expander / grouped card: aligned with the card title
// (left inset 52 = 16 padding + 20 icon + 16 gap).
export component CardRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> divider: true;

    VerticalLayout {
        if root.divider: Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        Tip {
            tip: root.tip;
            HorizontalLayout {
                padding-left: 52px;
                padding-right: Theme.card-padding;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 16px;
                min-height: 56px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    min-width: 120px;
                    Text {
                        text: root.title;
                        font-size: Theme.body;
                        color: root.enabled ? Theme.text : Theme.text-disabled;
                        wrap: word-wrap;
                    }
                    if root.description != "": Caption {
                        text: root.description;
                        color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        spacing: 8px;
                        @children
                    }
                }
            }
        }
    }
}

// Expandable settings card (Windows 11 "SettingsExpander").
export component ExpanderCard inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> tip;
    in-out property <bool> expanded: false;

    background: Theme.card-bg;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;
    accessible-role: groupbox;
    accessible-label: root.title;

    VerticalLayout {
        header := Tip {
            tip: root.tip;
            focused: fs.has-focus;
            clicked => {
                root.expanded = !root.expanded;
            }
            fs := FocusScope {
                key-pressed(e) => {
                    if e.text == " " || e.text == Key.Return {
                        root.expanded = !root.expanded;
                        return accept;
                    }
                    reject
                }
                HorizontalLayout {
                    padding-left: Theme.card-padding;
                    padding-right: Theme.card-padding;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 16px;
                    min-height: 68px;
                    VerticalLayout {
                        alignment: center;
                        FluentIcon {
                            source: root.icon;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.title;
                            font-size: Theme.body;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if root.description != "": Caption {
                            text: root.description;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 4px;
                            background: header.has-hover ? Theme.nav-hover : transparent;
                            FluentIcon {
                                width: 16px;
                                height: 16px;
                                source: root.expanded ? Icons.chevron-up : Icons.chevron-down;
                                tint: Theme.text-secondary;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: root.expanded ? content.preferred-height : 0px;
            clip: true;
            background: Theme.card-inner;
            content := VerticalLayout {
                y: 0px;
                height: self.preferred-height;
                @children
            }
        }
    }
    if fs.has-focus: Rectangle {
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.text;
    }
}

// --------------------------------------------------------------- InfoBar

export component InfoBar inherits Rectangle {
    in property <Severity> severity: Severity.info;
    in property <string> title;
    in property <string> message;
    in property <string> action;
    in property <string> action-tip;
    callback action-clicked();

    background: Theme.severity-bg(root.severity);
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.dark ? #0000001a : #0000000f;
    accessible-role: text;
    accessible-label: root.title + "：" + root.message;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            FluentIcon {
                source: Icons.severity(root.severity);
                tint: Theme.severity-icon-color(root.severity);
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.message != "": Text {
                text: root.message;
                font-size: Theme.body;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            Tip {
                tip: root.action-tip;
                focused: btn.has-focus;
                btn := Button {
                    text: root.action;
                    clicked => {
                        root.action-clicked();
                    }
                }
            }
        }
    }
}

// ----------------------------------------------------------------- meter

export component Meter {
    in property <image> icon;
    in property <string> name;
    in property <string> hint;
    in property <string> tip;
    in property <float> level;          // 0..1
    in property <string> value-text;
    in property <bool> active;

    Tip {
        tip: root.tip;
        HorizontalLayout {
            spacing: 16px;
            padding-top: 6px;
            padding-bottom: 6px;
            VerticalLayout {
                alignment: center;
                FluentIcon {
                    source: root.icon;
                    tint: Theme.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                width: 36%;
                Text {
                    text: root.name;
                    font-size: Theme.body;
                    color: Theme.text;
                }
                Caption {
                    text: root.hint;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                track := Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.track;
                    Rectangle {
                        x: 0px;
                        width: max(0px, min(1, root.level)) * track.width;
                        height: parent.height;
                        border-radius: 3px;
                        background: root.active ? Theme.accent : Theme.text-disabled;
                        animate width { duration: 90ms; }
                    }
                }
            }
            Text {
                width: 64px;
                text: root.value-text;
                font-size: Theme.caption;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// ------------------------------------------------------------ navigation

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> tip;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> external;
    callback clicked();

    height: 36px;
    border-radius: 4px;
    background: ta.pressed ? Theme.nav-hover : root.selected || ta.has-hover ? Theme.nav-selected : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    ta := Tip {
        tip: root.tip;
        focused: fs.has-focus;
        clicked => {
            root.clicked();
        }
        fs := FocusScope {
            key-pressed(e) => {
                if e.text == " " || e.text == Key.Return {
                    root.clicked();
                    return accept;
                }
                reject
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    FluentIcon {
                        source: root.icon;
                        tint: Theme.text;
                    }
                }
                if !root.compact: Text {
                    text: root.text;
                    font-size: Theme.body;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if !root.compact && root.external: VerticalLayout {
                    alignment: center;
                    FluentIcon {
                        width: 14px;
                        height: 14px;
                        source: Icons.open;
                        tint: Theme.text-secondary;
                    }
                }
            }
        }
    }
    Rectangle {
        x: 0px;
        width: 3px;
        height: root.selected ? 16px : 0px;
        y: (root.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }
    if fs.has-focus: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.text;
    }
}

// -------------------------------------------------------- radio options
// Radio button with a title and a one-line description (Windows 11 style).

export component RadioOption {
    in property <string> title;
    in property <string> description;
    in property <string> tip;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    accessible-role: radio-button;
    accessible-checked: root.selected;
    accessible-label: root.title;
    accessible-description: root.description;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    ta := Tip {
        tip: root.tip;
        focused: fs.has-focus;
        enabled: root.enabled;
        clicked => {
            if root.enabled {
                fs.focus();
                root.clicked();
            }
        }
        fs := FocusScope {
            enabled: root.enabled;
            key-pressed(e) => {
                if e.text == " " || e.text == Key.Return {
                    root.clicked();
                    return accept;
                }
                reject
            }
            HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 12px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    outer := Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: root.selected ? 0px : 1px;
                        border-color: root.enabled ? Palette.foreground.with-alpha(0.6) : Theme.text-disabled;
                        background: root.selected ? (root.enabled ? Theme.accent : Theme.text-disabled) : (ta.has-hover && root.enabled ? Theme.nav-hover : transparent);
                        Rectangle {
                            width: root.selected ? (ta.pressed ? 8px : (ta.has-hover ? 12px : 10px)) : (ta.pressed && root.enabled ? 10px : 0px);
                            height: self.width;
                            border-radius: self.width / 2;
                            background: root.selected ? Theme.on-accent : Theme.text-secondary;
                            animate width { duration: 120ms; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        font-size: Theme.body;
                        color: root.enabled ? Theme.text : Theme.text-disabled;
                        wrap: word-wrap;
                    }
                    if root.description != "": Caption {
                        text: root.description;
                        color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                    }
                }
            }
        }
    }
    if fs.has-focus: Rectangle {
        x: -4px;
        y: 0px;
        width: parent.width + 8px;
        height: parent.height;
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.text;
    }
}

// ------------------------------------------------------------- hyperlink

export component LinkText inherits Text {
    in property <string> url;
    in property <string> tip;
    callback activated();
    color: ta.pressed ? Theme.text-secondary : Theme.accent-text;
    font-size: Theme.body;
    accessible-role: button;
    accessible-action-default => { root.activated(); }

    ta := Tip {
        tip: root.tip;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 1px;
        background: ta.has-hover ? root.color : transparent;
    }
}

// ------------------------------------------------------- dialog / toast

export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <string> primary-text;
    in property <string> secondary-text: "取消";
    in property <bool> primary-enabled: true;
    callback primary();
    callback secondary();

    background: Theme.scrim;
    // swallow clicks on the scrim
    TouchArea { }

    card := Rectangle {
        width: min(520px, root.width - 48px);
        height: min(lay.preferred-height, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.dark ? #2b2b2b : #ffffff;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.flyout-border;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000052;
        clip: true;

        lay := VerticalLayout {
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.title;
                    font-size: Theme.subtitle;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                @children
            }
            Rectangle {
                background: Theme.dark ? #202020 : #f3f3f3;
                border-width: 0px;
                HorizontalLayout {
                    padding: 24px;
                    spacing: 8px;
                    Button {
                        text: root.primary-text;
                        primary: true;
                        enabled: root.primary-enabled;
                        horizontal-stretch: 1;
                        clicked => {
                            root.primary();
                        }
                    }
                    Button {
                        text: root.secondary-text;
                        horizontal-stretch: 1;
                        clicked => {
                            root.secondary();
                        }
                    }
                }
            }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> shown;

    width: lay.preferred-width;
    height: 40px;
    border-radius: 20px;
    background: Theme.flyout-bg;
    border-width: 1px;
    border-color: Theme.flyout-border;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.dark ? #00000066 : #00000029;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity { duration: 200ms; }

    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 18px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            FluentIcon {
                source: Icons.success-filled;
                tint: Theme.success-icon;
                width: 18px;
                height: 18px;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}
